APP_NAME=Subtitle Agent
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
DATA_ROOT=/data
SUBTITLE_AGENT_APP_MODE=WORKPACK
SUBTITLE_AGENT_MEDIA_ROOTS=/media/movies:/media/shows
MAX_CONCURRENT_JOBS=1
FFPROBE_TIMEOUT_SECONDS=30
FFMPEG_TIMEOUT_SECONDS=600
OCR_WORKER_URL=http://subtitle-ocr-worker:8090
INCLUDE_GRAPHIC_REFERENCE=false
OCR_TIMEOUT_SECONDS=900
OCR_MAX_OUTPUT_BYTES=20971520
WORKPACK_REFERENCE_SCORE_MARGIN=10
WORKPACK_MAX_REFERENCE_ALTERNATIVES=2
WORKPACK_INCLUDE_REFERENCE_ALTERNATIVES=true
WORKPACK_MAX_POLISH_CANDIDATES=10
WORKPACK_MAX_ARCHIVE_BYTES=104857600
WORKPACK_MAX_FILES=100
WORKPACK_RETENTION_HOURS=72
WORKPACK_CLEANUP_INTERVAL_HOURS=6

# Optional local semantic worker; disabled without URL. Token never goes to GUI.
LOCAL_WORKER_URL=
LOCAL_WORKER_TOKEN_FILE=
LOCAL_WORKER_TIMEOUT_SECONDS=120
LOCAL_WORKER_RETRIES=1
LOCAL_WORKER_BATCH_SIZE=32
LOCAL_WORKER_MAX_CUES=12000
LOCAL_CPU_FALLBACK_ENABLED=false
LOCAL_CPU_FALLBACK_URL=
# Compose parameters: SEMANTIC_TOKEN_FILE, AI_LAN_BIND_ADDRESS, AI_LAN_PORT
# Worker: AI_DEVICE=cpu|cuda, AI_DTYPE=float32|float16, AI_THREADS=2, AI_BATCH_SIZE=16
