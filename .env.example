APP_NAME=Subtitle Agent
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
DATA_ROOT=/data
SUBTITLE_AGENT_MEDIA_ROOTS=/media/movies:/media/shows
MAX_CONCURRENT_JOBS=1
FFPROBE_TIMEOUT_SECONDS=30
FFMPEG_TIMEOUT_SECONDS=600
ALIGNMENT_MIN_SCALE=0.94
ALIGNMENT_MAX_SCALE=1.06
ALIGNMENT_MAX_SEGMENTS=3
ALIGNMENT_MIN_POINTS_PER_SEGMENT=4
ALIGNMENT_END_TOLERANCE_MS=1000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=3
OPENAI_MAX_REQUESTS_PER_JOB=24
OPENAI_MAX_INPUT_TOKENS_PER_JOB=120000
OPENAI_MAX_OUTPUT_TOKENS_PER_JOB=12000
OPENAI_MAX_CONCURRENT_REQUESTS=2
OPENAI_SEMANTIC_ALIGNMENT_ENABLED=false
OPENAI_SEMANTIC_WINDOW_SIZE=18
OPENAI_SEMANTIC_WINDOW_OVERLAP=4
OPENAI_MIN_CONFIDENCE=0.72
SUBTITLE_AGENT_PUBLISH_ENABLED=false
SUBTITLE_AGENT_PUBLISH_MODE=PREVIEW_ONLY
SUBTITLE_AGENT_PUBLISH_MAPPINGS_JSON={"/media/movies":"/publish/movies","/media/shows":"/publish/shows"}
SUBTITLE_AGENT_AUTO_PUBLISH_MIN_QUALITY=HIGH
SUBTITLE_AGENT_AUTO_PUBLISH_REQUIRE_SEMANTIC=true
SUBTITLE_AGENT_PUBLISH_MAX_VERSION=999
SUBTITLE_AGENT_PUBLISH_FILE_MODE=0644
