FROM python:3.12-slim-bookworm AS common
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HOME=/cache \
    OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
WORKDIR /app
RUN groupadd --gid 10001 worker && useradd --uid 10001 --gid worker --home-dir /app worker \
    && mkdir /cache && chown worker:worker /cache
COPY requirements-semantic.txt ./

FROM common AS cpu
RUN pip install --no-cache-dir torch==2.8.0 -c requirements-semantic.txt --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements-semantic.txt
COPY semantic_worker semantic_worker
USER 10001:10001
ENV AI_DEVICE=cpu
EXPOSE 8091
CMD ["uvicorn", "semantic_worker.main:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1", "--no-access-log"]

FROM common AS cuda
RUN pip install --no-cache-dir torch==2.8.0 -c requirements-semantic.txt --index-url https://download.pytorch.org/whl/cu128 \
    && pip install --no-cache-dir -r requirements-semantic.txt
COPY semantic_worker semantic_worker
USER 10001:10001
ENV AI_DEVICE=cuda
EXPOSE 8091
CMD ["uvicorn", "semantic_worker.main:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1", "--no-access-log"]
